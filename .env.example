# ===== 必需 =====
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PASSWORD=

# 会话签名（个人提醒 cookie / 管理链接）。生产强烈建议独立配置；未设时回退 ADMIN_PASSWORD 并打 warn
SESSION_SECRET=

# 生产定时任务：至少配置其一
# 1) 自建调度 / Vercel Cron：Bearer CRON_SECRET
# 2) Upstash QStash：签名密钥（见下）
CRON_SECRET=

# ===== 邮件（个人到点提醒必需）=====
RESEND_API_KEY=
RESEND_FROM_EMAIL=ResetRadar <noreply@example.com>

# ===== Stripe（Pro 订阅，可选但上线收费需要）=====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ===== Telegram（可选）=====
TELEGRAM_BOT_TOKEN=
# 生产环境未配置则 webhook 直接 503，禁止静默放行
TELEGRAM_WEBHOOK_SECRET=

# ===== Web Push（计划中）=====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Upstash / QStash（线上推荐每 5 分钟打 POST /api/cron/reminders）=====
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
